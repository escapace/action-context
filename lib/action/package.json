{
  "name": "@escapace/action-context",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/action-context/issues",
  "devDependencies": {
    "@actions/core": "3.0.0",
    "@actions/github": "9.0.0",
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@escapace/pnpm-pack": "0.6.3",
    "@ls-lint/ls-lint": "2.3.1",
    "@pnpm/workspace.find-packages": "1000.0.58",
    "@pnpm/workspace.read-manifest": "1000.2.10",
    "@types/node": "25.2.3",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.0.18",
    "changelogen": "0.6.2",
    "changelogithub": "14.0.0",
    "es-toolkit": "1.44.0",
    "eslint": "9.39.2",
    "eslint-config-escapace": "5.10.2",
    "esroll": "1.1.1",
    "execa": "9.6.1",
    "knip": "5.83.1",
    "lefthook": "2.1.0",
    "p-memoize": "8.0.0",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.1",
    "semver": "7.7.4",
    "syncpack": "13.0.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.28.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/action-context#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "private": true,
  "repository": "escapace/action-context",
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --production --no-optional --extract --pack-destination lib/action && echo '!*' > lib/action/.gitignore",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  }
}