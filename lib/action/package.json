  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/action-context/issues",
  "devDependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.0",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@escapace/pnpm-pack": "0.5.2",
    "@ls-lint/ls-lint": "2.2.3",
    "@pnpm/workspace.find-packages": "4.0.12",
    "@pnpm/workspace.read-manifest": "2.2.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.9.0",
    "@types/semver": "7.5.8",
    "@vitest/coverage-v8": "2.1.4",
    "changelogen": "0.5.7",
    "changelogithub": "0.13.11",
    "eslint": "9.14.0",
    "eslint-config-escapace": "5.2.3",
    "esroll": "0.2.0",
    "execa": "9.5.1",
    "knip": "5.36.3",
    "lefthook": "1.8.2",
    "lodash-es": "4.17.21",
    "prettier": "3.3.3",
    "prettier-config-escapace": "1.2.1",
    "semver": "7.6.3",
    "syncpack": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20.15.0",
    "pnpm": ">=9.11.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/action-context#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "private": true,
  "repository": "escapace/action-context",
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --production --no-optional --extract --pack-destination lib/action && echo '!*' > lib/action/.gitignore",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  }
}