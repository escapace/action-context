{
  "name": "@escapace/action-context",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/action-context/issues",
  "devDependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@escapace/pnpm-pack": "0.6.0",
    "@ls-lint/ls-lint": "2.3.0",
    "@pnpm/workspace.find-packages": "1000.0.24",
    "@pnpm/workspace.read-manifest": "1000.1.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.15.19",
    "@types/semver": "7.7.0",
    "@vitest/coverage-v8": "3.1.4",
    "changelogen": "0.6.1",
    "changelogithub": "13.14.0",
    "eslint": "9.27.0",
    "eslint-config-escapace": "5.6.0",
    "esroll": "0.4.4",
    "execa": "9.5.3",
    "knip": "5.56.0",
    "lefthook": "1.11.13",
    "lodash-es": "4.17.21",
    "prettier": "3.5.3",
    "prettier-config-escapace": "1.2.1",
    "semver": "7.7.2",
    "syncpack": "13.0.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.4.1"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/action-context#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild"
    ]
  },
  "private": true,
  "repository": "escapace/action-context",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --production --no-optional --extract --pack-destination lib/action && echo '!*' > lib/action/.gitignore",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
